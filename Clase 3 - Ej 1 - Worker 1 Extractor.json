      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"nombre_cliente\": {\n      \"type\": \"string\"\n    },\n    \"email_cliente\": {\n      \"type\": \"string\"\n    },\n    \"empresa\": {\n      \"type\": \"string\"\n    },\n    \"nivel_urgencia\": {\n      \"type\": \"string\",\n      \"enum\": [\"ALTA\", \"MEDIA\", \"BAJA\", \"NO_INFORMADA\"]\n    }\n  },\n  \"required\": [\n    \"nombre_cliente\",\n    \"email_cliente\",\n    \"empresa\",\n    \"nivel_urgencia\"\n  ],\n  \"additionalProperties\": false\n}"
